{
  "manifest_version": 3,
  "name": "agkAInakem — Words for Feelings",
  "short_name": "agkAInakem",
  "version": "0.3.0",
  "description": "Hold Shift and hover over words on any page to see their meaning, related words, and how they differ from similar ones.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "agkAInakem",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "lookup-selection": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Look up the selected text"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "panel.js",
        "hover.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}