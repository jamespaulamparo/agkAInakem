DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Vite dev server origin(s) allowed to call the API during development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: use PostgreSQL instead of SQLite
# DATABASE_URL=postgres://user:password@localhost:5432/agkainakem
# Optional: send password-reset emails (otherwise they are printed in the server window)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=agkAInakem <you@example.com>
